{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "gen:api": "uv run --project ../api im openapi lib/api/openapi.json && openapi-typescript lib/api/openapi.json -o lib/api/schema.ts",
    "e2e": "NODE_EXTRA_CA_CERTS=${NODE_EXTRA_CA_CERTS:-$HOME/.portless/ca.pem} playwright test"
  },
  "dependencies": {
    "@ag-ui/client": "^1.0.0",
    "@ag-ui/core": "^1.0.0",
    "@sigma/node-border": "^3.0.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.41",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-types": "^0.24.8",
    "lucide-react": "^1.47.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sigma": "^3.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  },
  "packageManager": "pnpm@11.0.8"
}

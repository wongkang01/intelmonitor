# Copy to .env and fill in. Never commit .env.

# --- Required ---

# LLM: findings, summaries, and the Generate dashboard agent.
# Runs through the Claude Agent SDK on your Claude login. Leave the key blank:
# if set, the SDK bills the API key instead of the subscription allowance.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Jev (TypeSafe) via OpenRouter: relevance, tagging, routing, dedup, materiality.
# The typesafe_sdk works unchanged with an OpenRouter key and base URL.
# Docs: https://openrouter.ai/docs/guides/community/typesafe-sdk
OPENROUTER_API_KEY=
TYPESAFE_BASE_URL=https://openrouter.ai/api
# Pinned so tuned confidence thresholds don't shift when a new Jev ships.
TYPESAFE_DEFAULT_MODEL=jev-1.13

# External news and web documents. At least one is required; both give better coverage.
EXA_API_KEY=
TAVILY_API_KEY=

# --- Optional: structured data for trend charts ---

# Macro and FX series for country entities. Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Stablecoin prices and depegs. Free demo key. DefiLlama (supply) needs no key.
COINGECKO_API_KEY=

# MAS statistics APIs (https://eservices.mas.gov.sg/apimg-portal/api-catalog).
# System-wide aggregates, not per bank. Keys go in a `keyid` request header.
# Per-API paths (e.g. /server/monthly_statistical_bulletin/table_i_3b_commercial_banks_assets/
# views/table_i_3b_commercial_banks_assets) live in code. If one key covers all, repeat it.
MAS_API_BASE_URL=https://eservices.mas.gov.sg/apimg-gw
MAS_EXCHANGE_RATES_API_KEY=
MAS_BANK_ASSETS_API_KEY=
MAS_BANK_LIQUIDITY_API_KEY=
MAS_BANK_EXPOSURE_API_KEY=

# --- No key needed ---
# Central bank primary sources: MAS search API, Fed/ECB/BoE/FSB RSS,
# BIS central bankers' speeches RSS, HKMA open API.
# Also DefiLlama stablecoins, World Bank, GDELT.
